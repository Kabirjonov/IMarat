generator client {
  provider   = "prisma-client"
  output     = "./generated/main"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Project {
  id          String        @id @default(uuid())
  title       String
  slug        String        @unique
  description String
  shortDesc   String?
  images      String[]
  address     String
  latitude    Float?
  longitude   Float?
  type        ProjectType
  status      ProjectStatus
  priceFrom   Float?
  area        Float?
  rooms       Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum ProjectType {
  apartment
  house
  commercial
  entertainment
}

enum ProjectStatus {
  planned
  construction
  finished
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}
